<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!--
      Auto Root is driven from BOOT_COMPLETED and polls for up to two minutes
      after the native run. WAKE_LOCK is what keeps that wait from being decided
      by a suspend: a device that slept through the post-root window would report
      a failure that never happened, after the page-cache writes.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Declared for the automatic reboot the arming dialog performs, so the
      arming is not lost to the ten seconds it takes to reach the system menu.

      signature|privileged, and this app is not platform-signed - but
      PowerManagerService enforces with enforceCallingOrSelfPermission, which
      resolves against the UID, and android.uid.system (1000) holds REBOOT
      through the framework's own `android` package. That is an argument from
      how enforcement works, not an observation: the first physical press is
      the measurement, and RebootRequest reports the exact exception so a
      refusal names its own cause.
    -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!--
      The verdict notification is the only channel an unattended boot-time run has
      to a human: this firmware's default log buffer is 128 KiB per buffer and
      system_server saturates it in seconds, so the [DFR][*] trace of a boot run is
      gone long before anyone can read it. A missing grant degrades to "no
      notification" and never changes a run's outcome - RootNotifier logs the
      failure and returns.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:process="system"
        >
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TerminalActivity"
            android:exported="false" />
        <receiver
            android:name=".StageReceiver"
            android:exported="false" />
        <!--
          exported="true" only because BOOT_COMPLETED is delivered by the system,
          not by this app. It is a protected broadcast, the action is compared in
          onReceive, and the receiver authorises nothing: DfrAutoRootService
          re-derives permission from AutoRootPolicy plus observed device state, and
          its first requirement is a qualification record no sender can forge.
        -->
        <receiver
            android:name=".DfrBootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!--
          Never exported. Only DfrBootReceiver, in this package, may start it; an
          external component asking for an automatic root run is exactly what this
          must not offer.
        -->
        <service
            android:name=".DfrAutoRootService"
            android:exported="false"
            android:directBootAware="true" />
        <!--
          JobScheduler binds from the system through this standard exported
          JobService boundary. BIND_JOB_SERVICE is a signature permission and
          remains the authorization gate. The service is observation-only: it
          writes an early-boot marker and never reaches root or StageHop dispatch.
        -->
        <service
            android:name=".DfrEarlyBootJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true"
            android:directBootAware="true" />
        <!--
          Early Integrated Root. A SECOND, separate persisted job, not a mode of
          the probe above: the probe exists to time itself against
          LOCKED_BOOT_COMPLETED and must stay observation-only for that
          measurement to remain repeatable, and a callback that can dispatch the
          chain must not be reachable by arming a probe.

          exported="true" is the standard JobService boundary - JobScheduler binds
          from the system - and BIND_JOB_SERVICE, a signature permission, remains
          the authorization gate. It authorises nothing on arrival either: the
          callback re-derives everything from EarlyRootPolicy, whose first
          requirement is a one-shot arm record bound to a previous boot and a
          qualification no external sender can produce.
        -->
        <service
            android:name=".DfrEarlyRootJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true"
            android:directBootAware="true" />
        <!--
          Never exported. Only DfrEarlyRootJobService, in this package, may start
          it, and it re-derives the whole policy from its own observations - an
          external component asking for a root run inside the boot animation is
          exactly what this must not offer.
        -->
        <service
            android:name=".DfrEarlyRootService"
            android:exported="false"
            android:directBootAware="true" />
        <!--
          The notification action for "Apply Modules (Soft Reboot)", and since
          2026-10-15 also the early chain's handoff target. Never exported: both
          callers name this component explicitly, so the platform delivers with
          this app's own identity and no external caller needs - or gets - a way
          in. It authorises nothing on arrival either; SoftRebootPolicy
          re-derives every permission from the same-boot post-root record and a
          digest comparison on the binary it is about to invoke.

          directBootAware is REQUIRED, and was the third thing that silently
          killed the chained soft reboot. While the user is locked, PMS resolves
          only direct-boot-aware components, so a sendBroadcast naming a
          non-aware receiver matches nothing and is dropped with no error. The
          early chain runs pre-unlock - `user_unlocked=0` is measured at the
          callback in three consecutive boots - so before this attribute the
          handoff went nowhere. Every other component on that path
          (DfrBootReceiver, DfrAutoRootService, DfrEarlyBootJobService,
          DfrEarlyRootJobService, DfrEarlyRootService) already carries it; this
          receiver did not, because until now it was only ever reached by a
          notification tap, which happens after unlock.

          What this attribute does NOT establish: that the teardown behaves the
          same pre-unlock. The receiver's own records live in device-protected
          storage and the daemon is chosen through a root shell, so the gates
          themselves are reachable - but ksud's `soft_reboot()` re-running
          `on_post_data_fs` while credential-encrypted storage is still locked is
          a condition the manual path has never exercised. See
          docs/EARLY_ROOT.md.
        -->
        <receiver
            android:name=".DfrSoftRebootReceiver"
            android:exported="false"
            android:directBootAware="true" />
    </application>

</manifest>
